rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /boards/{boardId} {
      // Users can only see and modify their own boards, and can't reassign ownership.
      allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;

      // Notes belong to whoever owns the parent board.
      match /notes/{noteId} {
        allow read, write: if signedIn()
          && get(/databases/$(database)/documents/boards/$(boardId)).data.userId == request.auth.uid;
      }
    }
  }
}
